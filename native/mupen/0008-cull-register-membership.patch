+/* ntx: this pass queries immutable entry-map membership repeatedly. Keep the
+ * original get_reg exclusion rule, without rescanning HOST_REGS for each query. */
+static uint64_t ntx_missing_pre_regs(const signed char pre[], const signed char entry[])
+{
+  uint64_t present[2]={0,0}, missing=0;
+  int hr;
+  for(hr=0;hr<HOST_REGS;hr++) {
+    int r=entry[hr];
+    if(hr!=EXCLUDE_REG && r>=0)
+      present[(unsigned)r>>6]|=UINT64_C(1)<<(r&63);
+  }
+  for(hr=0;hr<HOST_REGS;hr++) {
+    int r=pre[hr];
+    if(r>=0 && !(present[(unsigned)r>>6] & (UINT64_C(1)<<(r&63))))
+      missing|=UINT64_C(1)<<hr;
+  }
+  return missing;
 }
 
