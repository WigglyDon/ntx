+/* ntx: index immutable branch destinations once per decoded block. Analysis
+ * values remain live; in particular future p32 and earlier branch_regs differ. */
+static int ntx_incoming_head[MAXBLOCK], ntx_incoming_next[MAXBLOCK];
+static void ntx_index_incoming(void)
+{
+  int t,j;
+  for(t=0;t<slen;t++) ntx_incoming_head[t]=-1;
+  for(j=slen-1;j>=0;j--) {
+    uint32_t offset=(uint32_t)ba[j]-start;
+    if(!(offset&3u) && (offset>>2)<(uint32_t)slen) {
+      t=(int)(offset>>2);
+      ntx_incoming_next[j]=ntx_incoming_head[t];
+      ntx_incoming_head[t]=j;
+    }
+  }
+}
+static uint64_t ntx_incoming_is32(int target,int cutoff,uint64_t value,int provisional)
+{
+  int j;
+  for(j=ntx_incoming_head[target];j>=0;j=ntx_incoming_next[j]) {
+    if(j<cutoff) value&=provisional?p32[j]:branch_regs[j].is32;
+    else if(provisional) value=1;
+    else value&=p32[j];
+  }
+  return value;
+}
