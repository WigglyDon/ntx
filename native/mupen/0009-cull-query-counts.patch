+/* ntx: track one queried value while the culling loop erases map entries.
+ * Negative/free values and duplicates retain the original getter semantics. */
+static unsigned ntx_reg_matches(const signed char map[],int key)
+{
+  unsigned count=0;
+  int hr;
+  for(hr=0;hr<HOST_REGS;hr++)
+    if(hr!=EXCLUDE_REG && map[hr]==key) count++;
+  return count;
+}
+static int ntx_query_present(const signed char map[],int key,unsigned *count)
+{
+  if(*count==~0u) *count=ntx_reg_matches(map,key);
+  return *count!=0;
+}
+static void ntx_erase_queried_reg(signed char map[],int hr,int key,unsigned *count)
+{
+  if(*count!=~0u && hr!=EXCLUDE_REG) {
+    *count-=(map[hr]==key);
+    *count+=(-1==key);
+  }
+  map[hr]=-1;
 }
 
