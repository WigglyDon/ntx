 void PluginAPI::GetUserCachePath(wchar_t * _strPath)
 {
+	// Directory ownership is supplied by the Rust host through the existing ABI.
+	const char * cacheDir = nullptr;
+	if (environ_cb(RETRO_ENVIRONMENT_GET_SAVE_DIRECTORY, &cacheDir) && cacheDir && *cacheDir) {
+		std::string path(cacheDir);
+		if (path.back() != '/' && path.back() != '\\')
+			path += "/";
+		_getWSPath(path.c_str(), _strPath);
+		return;
+	}
 	getRetroArchDir(_strPath);
 }
 
